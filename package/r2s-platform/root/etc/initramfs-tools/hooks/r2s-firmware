#!/bin/sh
# The built-in remoteproc driver needs RCPU firmware before mounting rootfs.
set -eu
case "${1:-}" in
    prereqs) exit 0 ;;
esac
# shellcheck disable=SC1091
. /usr/share/initramfs-tools/hook-functions
test -s /usr/lib/firmware/esos.elf
if ! copy_file firmware /usr/lib/firmware/esos.elf; then
    # copy_file returns 1 for an existing destination. The older KY hook may
    # already have copied it; accept that only when the bytes match exactly.
    if ! cmp -s /usr/lib/firmware/esos.elf "${DESTDIR}/usr/lib/firmware/esos.elf"; then
        cmp -s /usr/lib/firmware/esos.elf "${DESTDIR}/lib/firmware/esos.elf"
    fi
fi
